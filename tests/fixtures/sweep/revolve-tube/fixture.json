{
  "description": "rectangle x∈[1,2], z∈[−1,1] revolved 360° about z: a tube, two seams, genus 1",
  "steps": [
    {
      "name": "rect",
      "op": "profile",
      "plane": {"origin": [0, 0, 0], "x": [1, 0, 0], "y": [0, 0, 1]},
      "outer": {"start": [1, -1], "segments": [{"line_to": [2, -1]}, {"line_to": [2, 1]}, {"line_to": [1, 1]}, {"line_to": [1, -1]}]}
    },
    {"name": "result", "op": "revolve", "profile": "rect", "axis": {"origin": [0, 0, 0], "direction": [0, 0, 1]}, "angle_deg": 360}
  ],
  "result": "result",
  "probes": [
    {"label": "inside", "point": [1.5, 0, 0], "expect": "in"},
    {"label": "outside", "point": [2.5, 0, 0], "expect": "out"},
    {"label": "on_face", "point": [0, 1.5, 1], "expect": "on"},
    {"label": "on_edge", "point": [0, 2, 1], "expect": "on"},
    {"label": "on_axis", "point": [0, 0, 0], "expect": "out"}
  ],
  "analytic": {
    "volume": "pi * (4 - 1) * 2",
    "area": "2 * pi * (1 + 2) * 2 + 2 * pi * (4 - 1)",
    "centroid": [0, 0, 0],
    "counts": {"vertices": 4, "edges": 6, "faces": 4, "loops": 6, "shells": 1},
    "genus": 1
  }
}
