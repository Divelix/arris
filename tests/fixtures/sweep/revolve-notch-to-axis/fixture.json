        {"line_to": [1, 2]}, {"line_to": [1, 1]}, {"line_to": [0, 1]}, {"line_to": [0, 0]}
      ]}
    },
    {"name": "result", "op": "revolve", "profile": "notched", "axis": {"origin": [0, 0, 0], "direction": [0, 0, 1]}, "angle_deg": "angle"}
