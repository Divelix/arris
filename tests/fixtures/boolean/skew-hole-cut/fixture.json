{
  "description": "a main cylinder R 1, length L on z, less a drill r 0.4 on x whose axis passes d = 0.8 from the main's, skew to it: d + r > R > d − r, so the drill breaks out of the main's side and the two walls meet in one closed loop, traced and fitted as one periodic NURBS (ADR-0018) — a notch across the main cylinder (plans/quadric-intersection-curves step 8)",
  "params": {
    "R": 1,
    "r": 0.4,
    "d": 0.8,
    "L": 6,
    "turn": 30
  },
  "steps": [
    {
      "name": "main",
      "op": "cylinder",
      "base": [
        0,
        0,
        "-L / 2"
      ],
      "axis": [
        0,
        0,
        1
      ],
      "radius": "R",
      "height": "L"
    },
    {
      "name": "d0",
      "op": "cylinder",
      "base": [
        "-L / 2",
        "d",
        0
      ],
      "axis": [
        1,
        0,
        0
      ],
      "radius": "r",
      "height": "L"
    },
    {
      "name": "drill",
      "op": "transform",
      "of": "d0",
      "rotate": {
        "axis": [
          1,
          0,
          0
        ],
        "origin": [
          0,
          "d",
          0
        ],
        "angle_deg": "turn"
      }
    },
    {
      "name": "result",
      "op": "cut",
      "target": "main",
      "tool": "drill"
    }
  ],
  "result": "result",
  "probes": [
    {
      "label": "inside",
      "point": [
        0,
        0,
        0
      ],
      "expect": "in"
    },
    {
      "label": "in_the_notch",
      "point": [
        0,
        "d",
        0
      ],
      "expect": "out"
    },
    {
      "label": "beside_the_notch",
      "point": [
        0,
        "d",
        "0.8"
      ],
      "expect": "in"
    },
    {
      "label": "outside",
      "point": [
        "2 * R",
        0,
        0
      ],
      "expect": "out"
    },
    {
      "label": "on_main_wall",
      "point": [
        "-R",
        0,
        0
      ],
      "expect": "on"
    },
    {
      "label": "on_notch_floor",
      "point": [
        0,
        "d - r",
        0
      ],
      "expect": "on"
    },
    {
      "label": "on_notch_wall",
      "point": [
        0,
        "d",
        "r"
      ],
      "expect": "on"
    }
  ],
  "analytic": {
    "genus": 0
  }
}