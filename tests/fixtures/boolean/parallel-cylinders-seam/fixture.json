{
  "description": "parallel-cylinders-cut with the tool placed so that one ruling of the pair is the target's seam, (r, 0): the tool's axis 0.04 from the target's at (d²/2r, √(d² − d⁴/4r²)). The block of that ruling between the caps is an operand edge, the seam, not a section edge; the other ruling is a section edge as before (plans/cylinder-cylinder-booleans step 4). (πr² − lens)·h again. theta is acos(d / 2r) at full precision",
  "params": {"r": 0.03, "d": 0.04, "h": 0.01, "theta": 0.8410686705679301},
  "steps": [
    {"name": "target", "op": "cylinder", "base": [0, 0, 0], "axis": [0, 0, 1], "radius": "r", "height": "h"},
    {"name": "tool", "op": "cylinder", "base": ["d^2 / (2 * r)", "sqrt(d^2 - d^4 / (4 * r^2))", "-h / 2"], "axis": [0, 0, 1], "radius": "r", "height": "2 * h"},
    {"name": "result", "op": "cut", "target": "target", "tool": "tool"}
  ],
  "result": "result",
  "probes": [
    {"label": "inside", "point": ["-r / 2", 0, "h / 2"], "expect": "in"},
    {"label": "in_tool", "point": ["d^2 / (2 * r)", "sqrt(d^2 - d^4 / (4 * r^2))", "h / 2"], "expect": "out"},
    {"label": "below_the_seam", "point": ["r / 2", "-r / 4", "h / 2"], "expect": "in"},
    {"label": "on_seam_ruling", "point": ["r", 0, "h / 2"], "expect": "on"},
    {"label": "on_other_ruling", "point": ["d^2 / (2 * r) - r", "sqrt(d^2 - d^4 / (4 * r^2))", "h / 2"], "expect": "on"},
    {"label": "on_wall", "point": ["-r", 0, "h / 2"], "expect": "on"},
    {"label": "on_top", "point": ["-r / 2", 0, "h"], "expect": "on"}
  ],
  "tolerances": {"mesh_chord": 1e-5},
  "analytic": {
    "volume": "(pi * r^2 - (2 * r^2 * theta - d / 2 * sqrt(4 * r^2 - d^2))) * h",
    "area": "2 * (pi * r^2 - (2 * r^2 * theta - d / 2 * sqrt(4 * r^2 - d^2))) + 2 * pi * r * h",
    "genus": 0
  }
}
