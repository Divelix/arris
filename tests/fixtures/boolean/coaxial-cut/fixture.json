{
  "description": "cylinder r 2 from z −1 to 1 minus a coaxial cylinder r 1 that runs through it: a tube — the coaxial cylinder–cylinder pair has no section curve, and the bore's wall is the tool's wall reversed",
  "steps": [
    {"name": "outer", "op": "cylinder", "base": [0, 0, -1], "axis": [0, 0, 1], "radius": 2, "height": 2},
    {"name": "bore", "op": "cylinder", "base": [0, 0, -2], "axis": [0, 0, 1], "radius": 1, "height": 4},
    {"name": "result", "op": "cut", "target": "outer", "tool": "bore"}
  ],
  "result": "result",
  "probes": [
    {"label": "inside", "point": [1.5, 0, 0], "expect": "in"},
    {"label": "outside", "point": [2.5, 0, 0], "expect": "out"},
    {"label": "on_face", "point": [0, 1.5, 1], "expect": "on"},
    {"label": "on_edge", "point": [0, 2, 1], "expect": "on"},
    {"label": "on_axis", "point": [0, 0, 0], "expect": "out"}
  ],
  "analytic": {
    "volume": "pi * (4 - 1) * 2",
    "area": "2 * pi * (1 + 2) * 2 + 2 * pi * (4 - 1)",
    "centroid": [0, 0, 0],
    "counts": {"vertices": 4, "edges": 6, "faces": 4, "loops": 6, "shells": 1},
    "genus": 1
  }
}
