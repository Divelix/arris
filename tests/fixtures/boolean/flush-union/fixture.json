  "result": "result",
  "probes": [
    {"label": "inside", "point": [40, 15, 5], "expect": "in"},
    {"label": "outside", "point": [90, 15, 5], "expect": "out"},
    {"label": "on_face", "point": [60, 15, 10], "expect": "on"},
    {"label": "on_edge", "point": [40, 30, 10], "expect": "on"},
    {"label": "on_former_edge", "point": [40, 15, 10], "expect": "on"}
  ],
  "analytic": {
    "volume": 24000,
    "area": 7000,
    "centroid": [40, 15, 5],
