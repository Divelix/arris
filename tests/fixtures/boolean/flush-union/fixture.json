    {"name": "a", "op": "box", "min": [0, 0, 0], "max": [40, 30, 10]},
    {"name": "b", "op": "box", "min": [40, 0, 0], "max": [80, 30, 10]},
    {"name": "result", "op": "fuse", "a": "a", "b": "b"}
