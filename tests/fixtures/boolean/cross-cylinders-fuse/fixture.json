{
  "description": "the two crossing cylinders of cross-cylinders-common fused: 2πR²L − 16R³/3, each wall keeping the two pieces outside the other cylinder, whose boundaries meet at the crossing vertices (0, ±R, 0) (plans/cylinder-cylinder-booleans step 2)",
  "params": {"R": 1, "L": 6, "turn": 30},
  "steps": [
    {"name": "a", "op": "cylinder", "base": [0, 0, "-L / 2"], "axis": [0, 0, 1], "radius": "R", "height": "L"},
    {"name": "b0", "op": "cylinder", "base": ["-L / 2", 0, 0], "axis": [1, 0, 0], "radius": "R", "height": "L"},
    {"name": "b", "op": "transform", "of": "b0", "rotate": {"axis": [1, 0, 0], "angle_deg": "turn"}},
    {"name": "result", "op": "fuse", "a": "a", "b": "b"}
  ],
  "result": "result",
  "probes": [
    {"label": "inside", "point": [0, 0, 0], "expect": "in"},
    {"label": "in_a", "point": [0, 0, 2], "expect": "in"},
    {"label": "in_b", "point": [2, 0, 0], "expect": "in"},
    {"label": "outside", "point": [2, 2, 0], "expect": "out"},
    {"label": "on_a_cap", "point": [0, 0, "L / 2"], "expect": "on"},
    {"label": "on_a_wall", "point": ["R * cos(radians(20))", "R * sin(radians(20))", 2], "expect": "on"},
    {"label": "on_b_wall", "point": [2, 0, "R"], "expect": "on"},
    {"label": "on_section", "point": ["R * cos(radians(45))", "R * sin(radians(45))", "R * cos(radians(45))"], "expect": "on"},
    {"label": "on_crossing", "point": [0, "R", 0], "expect": "on"}
  ],
  "analytic": {
    "volume": "2 * pi * R^2 * L - 16 * R^3 / 3",
    "area": "2 * (2 * pi * R * L + 2 * pi * R^2) - 16 * R^2",
    "centroid": [0, 0, 0],
    "counts": {"vertices": 10, "edges": 16, "faces": 8, "loops": 8, "shells": 1},
    "counts_differ": "Open CASCADE also cuts the section arc that runs through the second ellipse's parameter origin (−R, 0, R) there, one more vertex and edge; Arris's edge range crosses the period once (E1) and the arc is one edge between the paves the seams and the crossing vertices make",
    "genus": 0
  }
}
