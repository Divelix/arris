{
  "description": "coaxial-fuse's rod, filling the tube's bore, moved off the shared axis by a quarter of a tolerance (1e-7), either way along x, fused: the flush union, a whole rod. Four off is coaxial-fuse-four-off and coaxial-fuse-four-off-back (plans/c3-tolerance-apart step 9, the band's ends).",
  "params": {"d": 2.5e-08, "t": 0, "g": 0},
  "variants": {
    "minus-quarter": {"d": -2.5e-08, "t": 0, "g": 0}
  },
  "steps": [
    {"name": "a_wall", "op": "cylinder", "base": [0, 0, 0], "axis": [0, 0, 1], "radius": 2, "height": 2},
    {"name": "a_bore", "op": "cylinder", "base": [0, 0, -1], "axis": [0, 0, 1], "radius": 1, "height": 4},
    {"name": "a", "op": "cut", "target": "a_wall", "tool": "a_bore"},
    {"name": "b0", "op": "cylinder", "base": [0, 0, 0], "axis": [0, 0, 1], "radius": 1, "height": 2},
    {"name": "b", "op": "transform", "of": "b0", "rotate": {"axis": [0, 1, 0], "origin": [0, 0, 1], "angle_deg": "degrees(2 * t / 2)"}, "translate": ["1 * d", "0 * d", "0 * d"]},
    {"name": "result", "op": "fuse", "a": "a", "b": "b"}
  ],
  "result": "result",
  "analytic": {}
}
