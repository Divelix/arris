{
  "description": "parallel-cylinders-cut's operands, common: the lens prism between the two rulings, lens·h, bounded by an arc of each wall (plans/cylinder-cylinder-booleans step 4). theta is acos(d / 2r) at full precision",
  "params": {"r": 0.03, "d": 0.04, "h": 0.01, "theta": 0.8410686705679301},
  "steps": [
    {"name": "a", "op": "cylinder", "base": [0, 0, 0], "axis": [0, 0, 1], "radius": "r", "height": "h"},
    {"name": "b", "op": "cylinder", "base": ["d", 0, "-h / 2"], "axis": [0, 0, 1], "radius": "r", "height": "2 * h"},
    {"name": "result", "op": "common", "a": "a", "b": "b"}
  ],
  "result": "result",
  "probes": [
    {"label": "inside", "point": ["d / 2", 0, "h / 2"], "expect": "in"},
    {"label": "in_a_only", "point": ["-r / 2", 0, "h / 2"], "expect": "out"},
    {"label": "in_b_only", "point": ["d + r / 2", 0, "h / 2"], "expect": "out"},
    {"label": "on_a_arc", "point": ["r", 0, "h / 2"], "expect": "on"},
    {"label": "on_b_arc", "point": ["d - r", 0, "h / 2"], "expect": "on"},
    {"label": "on_ruling", "point": ["d / 2", "-sqrt(r^2 - d^2 / 4)", "h / 2"], "expect": "on"},
    {"label": "on_top", "point": ["d / 2", 0, "h"], "expect": "on"}
  ],
  "tolerances": {"mesh_chord": 1e-5},
  "analytic": {
    "volume": "(2 * r^2 * theta - d / 2 * sqrt(4 * r^2 - d^2)) * h",
    "area": "2 * (2 * r^2 * theta - d / 2 * sqrt(4 * r^2 - d^2)) + 4 * r * theta * h",
    "genus": 0
  }
}
