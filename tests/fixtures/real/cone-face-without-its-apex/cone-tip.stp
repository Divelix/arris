ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('a cone r 4, h 4 below its base, whose side face is bounded by its base circle alone, its apex left implicit'),'2;1');
FILE_NAME('cone-tip.stp','',(''),(''),'','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1 = APPLICATION_CONTEXT('core data for automotive mechanical design processes');
#2 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3 = PRODUCT_CONTEXT('',#1,'mechanical');
#4 = PRODUCT('part','part','',(#3));
#5 = PRODUCT_DEFINITION_FORMATION('','',#4);
#6 = PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#7 = PRODUCT_DEFINITION('design','',#5,#6);
#8 = PRODUCT_DEFINITION_SHAPE('','',#7);
#9 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#4));
#10 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#11 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#12 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#13 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#10,'distance_accuracy_value','confusion accuracy');
#14 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12)) REPRESENTATION_CONTEXT('Context #1','3D Context with UNIT and UNCERTAINTY') );
#16 = AXIS2_PLACEMENT_3D('',#17,#18,#19);
#17 = CARTESIAN_POINT('',(0.,0.,0.));
#18 = DIRECTION('',(0.,0.,1.));
#19 = DIRECTION('',(1.,0.,0.));
#20 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#16,#22),#14);
#21 = SHAPE_DEFINITION_REPRESENTATION(#8,#20);
#22 = MANIFOLD_SOLID_BREP('',#23);
#23 = CLOSED_SHELL('',(#30,#40));
#24 = CARTESIAN_POINT('',(4.,0.,0.));
#25 = VERTEX_POINT('',#24);
#60 = CARTESIAN_POINT('',(0.,0.,0.));
#62 = DIRECTION('',(0.,0.,1.));
#63 = DIRECTION('',(1.,0.,0.));
#64 = AXIS2_PLACEMENT_3D('',#60,#62,#63);
#66 = CIRCLE('',#64,4.);
#68 = EDGE_CURVE('',#25,#25,#66,.T.);
#70 = PLANE('',#64);
#72 = CONICAL_SURFACE('',#64,4.,0.785398163397448);
#30 = ADVANCED_FACE('',(#31),#70,.T.);
#31 = FACE_OUTER_BOUND('',#32,.T.);
#32 = EDGE_LOOP('',(#33));
#33 = ORIENTED_EDGE('',*,*,#68,.T.);
#40 = ADVANCED_FACE('',(#41),#72,.T.);
#41 = FACE_OUTER_BOUND('',#42,.T.);
#42 = EDGE_LOOP('',(#43));
#43 = ORIENTED_EDGE('',*,*,#68,.F.);
ENDSEC;
END-ISO-10303-21;
