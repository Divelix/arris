#96 = SHAPE_REPRESENTATION_RELATIONSHIP('','',#95,#20);
#97 = SHAPE_REPRESENTATION('solid data',(#22),#14);
#22 = MANIFOLD_SOLID_BREP('',#23);
#23 = CLOSED_SHELL('',(#30,#40));
#24 = CARTESIAN_POINT('',(0.,0.,5.));
#25 = VERTEX_POINT('',#24);
#60 = CARTESIAN_POINT('',(0.,0.,0.));
#61 = DIRECTION('',(0.,0.,1.));
#62 = DIRECTION('',(1.,0.,0.));
#63 = DIRECTION('',(0.,1.,0.));
#64 = DIRECTION('',(0.,-1.,0.));
#65 = AXIS2_PLACEMENT_3D('',#60,#61,#62);
#66 = AXIS2_PLACEMENT_3D('',#60,#63,#61);
#67 = AXIS2_PLACEMENT_3D('',#60,#64,#62);
#68 = CIRCLE('',#66,5.);
#69 = EDGE_CURVE('',#25,#25,#68,.T.);
#70 = SPHERICAL_SURFACE('',#65,5.);
#71 = PLANE('',#67);
#30 = ADVANCED_FACE('',(#31),#70,.T.);
#31 = FACE_OUTER_BOUND('',#32,.T.);
#32 = EDGE_LOOP('',(#33));
#33 = ORIENTED_EDGE('',*,*,#69,.T.);
#40 = ADVANCED_FACE('',(#41),#71,.T.);
#41 = FACE_OUTER_BOUND('',#42,.T.);
#42 = EDGE_LOOP('',(#43));
#43 = ORIENTED_EDGE('',*,*,#69,.F.);
