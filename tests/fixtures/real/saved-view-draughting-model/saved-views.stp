#88 = MAPPED_ITEM('',#87,#81);
#89 = ( DRAUGHTING_MODEL() REPRESENTATION('view 1',(#86,#88),#14) );
#90 = REPRESENTATION_MAP(#81,#20);
#91 = CARTESIAN_POINT('',(20.,0.,0.));
#92 = AXIS2_PLACEMENT_3D('',#91,$,$);
