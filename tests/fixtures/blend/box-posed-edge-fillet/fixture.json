{
  "description": "box-edge-fillet's cube rotated 90\u00b0 about (1, 1, 1) and moved before the fillet: the edge and every probe named by the rotation's closed form, the blend in an oblique pose",
  "params": {
    "r": 0.2
  },
  "steps": [
    {
      "name": "cube",
      "op": "box",
      "min": [
        0,
        0,
        0
      ],
      "max": [
        2,
        2,
        2
      ]
    },
    {
      "name": "posed",
      "op": "transform",
      "of": "cube",
      "rotate": {
        "axis": [
          1,
          1,
          1
        ],
        "angle_deg": 90
      },
      "translate": [
        0.5,
        -0.25,
        0.75
      ]
    },
    {
      "name": "result",
      "op": "fillet",
      "of": "posed",
      "edges": [
        [
          "(2) / 3 + (2) * (1 / 3 - 1 / sqrt(3)) + (1) * (1 / 3 + 1 / sqrt(3)) + 0.5",
          "(2) * (1 / 3 + 1 / sqrt(3)) + (2) / 3 + (1) * (1 / 3 - 1 / sqrt(3)) + -0.25",
          "(2) * (1 / 3 - 1 / sqrt(3)) + (2) * (1 / 3 + 1 / sqrt(3)) + (1) / 3 + 0.75"
        ]
      ],
      "radius": "r"
    }
  ],
  "result": "result",
  "probes": [
    {
      "label": "inside",
      "point": [
        "(1) / 3 + (1) * (1 / 3 - 1 / sqrt(3)) + (1) * (1 / 3 + 1 / sqrt(3)) + 0.5",
        "(1) * (1 / 3 + 1 / sqrt(3)) + (1) / 3 + (1) * (1 / 3 - 1 / sqrt(3)) + -0.25",
        "(1) * (1 / 3 - 1 / sqrt(3)) + (1) * (1 / 3 + 1 / sqrt(3)) + (1) / 3 + 0.75"
      ],
      "expect": "in"
    },
    {
      "label": "corner_gone",
      "point": [
        "(1.95) / 3 + (1.95) * (1 / 3 - 1 / sqrt(3)) + (1) * (1 / 3 + 1 / sqrt(3)) + 0.5",
        "(1.95) * (1 / 3 + 1 / sqrt(3)) + (1.95) / 3 + (1) * (1 / 3 - 1 / sqrt(3)) + -0.25",
        "(1.95) * (1 / 3 - 1 / sqrt(3)) + (1.95) * (1 / 3 + 1 / sqrt(3)) + (1) / 3 + 0.75"
      ],
      "expect": "out"
    },
    {
      "label": "on_blend",
      "point": [
        "(2 - r + r / sqrt(2)) / 3 + (2 - r + r / sqrt(2)) * (1 / 3 - 1 / sqrt(3)) + (1) * (1 / 3 + 1 / sqrt(3)) + 0.5",
        "(2 - r + r / sqrt(2)) * (1 / 3 + 1 / sqrt(3)) + (2 - r + r / sqrt(2)) / 3 + (1) * (1 / 3 - 1 / sqrt(3)) + -0.25",
        "(2 - r + r / sqrt(2)) * (1 / 3 - 1 / sqrt(3)) + (2 - r + r / sqrt(2)) * (1 / 3 + 1 / sqrt(3)) + (1) / 3 + 0.75"
      ],
      "expect": "on"
    },
    {
      "label": "on_contact",
      "point": [
        "(2 - r) / 3 + (2) * (1 / 3 - 1 / sqrt(3)) + (1) * (1 / 3 + 1 / sqrt(3)) + 0.5",
        "(2 - r) * (1 / 3 + 1 / sqrt(3)) + (2) / 3 + (1) * (1 / 3 - 1 / sqrt(3)) + -0.25",
        "(2 - r) * (1 / 3 - 1 / sqrt(3)) + (2) * (1 / 3 + 1 / sqrt(3)) + (1) / 3 + 0.75"
      ],
      "expect": "on"
    },
    {
      "label": "on_arc",
      "point": [
        "(2 - r + r / sqrt(2)) / 3 + (2 - r + r / sqrt(2)) * (1 / 3 - 1 / sqrt(3)) + (2) * (1 / 3 + 1 / sqrt(3)) + 0.5",
        "(2 - r + r / sqrt(2)) * (1 / 3 + 1 / sqrt(3)) + (2 - r + r / sqrt(2)) / 3 + (2) * (1 / 3 - 1 / sqrt(3)) + -0.25",
        "(2 - r + r / sqrt(2)) * (1 / 3 - 1 / sqrt(3)) + (2 - r + r / sqrt(2)) * (1 / 3 + 1 / sqrt(3)) + (2) / 3 + 0.75"
      ],
      "expect": "on"
    },
    {
      "label": "on_top",
      "point": [
        "(1) / 3 + (1) * (1 / 3 - 1 / sqrt(3)) + (2) * (1 / 3 + 1 / sqrt(3)) + 0.5",
        "(1) * (1 / 3 + 1 / sqrt(3)) + (1) / 3 + (2) * (1 / 3 - 1 / sqrt(3)) + -0.25",
        "(1) * (1 / 3 - 1 / sqrt(3)) + (1) * (1 / 3 + 1 / sqrt(3)) + (2) / 3 + 0.75"
      ],
      "expect": "on"
    }
  ],
  "analytic": {
    "volume": "8 - (1 - pi / 4) * r^2 * 2",
    "area": "24 - 4 * r - 2 * (1 - pi / 4) * r^2 + pi * r",
    "counts": {
      "vertices": 10,
      "edges": 15,
      "faces": 7,
      "loops": 7,
      "shells": 1
    },
    "genus": 0
  }
}
