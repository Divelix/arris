{
  "description": "the consumer's 2-cube with one vertical edge chamfered at d 0.2: a plane–plane chamfer, a plane through the two contact lines at d from the edge on each face, its ends segments on the caps; the `larger` variant at d 0.5",
  "params": {"d": 0.2},
  "variants": {"larger": {"d": 0.5}},
  "steps": [
    {"name": "cube", "op": "box", "min": [0, 0, 0], "max": [2, 2, 2]},
    {"name": "result", "op": "chamfer", "of": "cube", "edges": [[2, 2, 1]], "distance": "d"}
  ],
  "result": "result",
  "probes": [
    {"label": "inside", "point": [1, 1, 1], "expect": "in"},
    {"label": "corner_gone", "point": ["2 - d / 4", "2 - d / 4", 1], "expect": "out"},
    {"label": "under_chamfer", "point": ["2 - 3 * d / 4", "2 - 3 * d / 4", 1], "expect": "in"},
    {"label": "on_chamfer", "point": ["2 - d / 2", "2 - d / 2", 1], "expect": "on"},
    {"label": "on_contact", "point": ["2 - d", 2, 1], "expect": "on"},
    {"label": "on_end", "point": ["2 - d / 2", "2 - d / 2", 2], "expect": "on"},
    {"label": "on_top", "point": [1, 1, 2], "expect": "on"},
    {"label": "far_vertex", "point": [0, 0, 0], "expect": "on"}
  ],
  "analytic": {
    "volume": "8 - d^2 / 2 * 2",
    "area": "24 - 4 * d - d^2 + 2 * sqrt(2) * d",
    "counts": {"vertices": 10, "edges": 15, "faces": 7, "loops": 7, "shells": 1},
    "genus": 0
  }
}
