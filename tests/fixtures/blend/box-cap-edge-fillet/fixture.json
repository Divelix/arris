{
  "description": "the same 2-cube with a top (cap) edge filleted at r 0.2 — the solid of box-edge-fillet rotated, the blend's ends now on two side faces",
  "params": {"r": 0.2},
  "steps": [
    {"name": "cube", "op": "box", "min": [0, 0, 0], "max": [2, 2, 2]},
    {"name": "result", "op": "fillet", "of": "cube", "edges": [[1, 2, 2]], "radius": "r"}
  ],
  "result": "result",
  "probes": [
    {"label": "inside", "point": [1, 1, 1], "expect": "in"},
    {"label": "corner_gone", "point": [1, 1.95, 1.95], "expect": "out"},
    {"label": "on_blend", "point": [1, "2 - r + r / sqrt(2)", "2 - r + r / sqrt(2)"], "expect": "on"},
    {"label": "on_contact", "point": [1, "2 - r", 2], "expect": "on"},
    {"label": "on_arc", "point": [2, "2 - r + r / sqrt(2)", "2 - r + r / sqrt(2)"], "expect": "on"},
    {"label": "on_side", "point": [2, 1, 1], "expect": "on"},
    {"label": "far_vertex", "point": [0, 0, 0], "expect": "on"}
  ],
  "analytic": {
    "volume": "8 - (1 - pi / 4) * r^2 * 2",
    "area": "24 - 4 * r - 2 * (1 - pi / 4) * r^2 + pi * r",
    "counts": {"vertices": 10, "edges": 15, "faces": 7, "loops": 7, "shells": 1},
    "genus": 0
  }
}
