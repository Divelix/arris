{
  "description": "the consumer's twin of a second blend on a blended body: a 2-square extruded 2, the side edge 0–1 (the rise at (2, 0)) filleted at r 0.2, then the side edge 1–2 (the rise at (2, 2)) of that result at r 0.2 — the two edges never meet, their blends share the side face x = 2, which the first blend modified and the second modifies again; volume and counts those of two disjoint blends",
  "params": {"r": 0.2},
  "steps": [
    {
      "name": "square",
      "op": "profile",
      "plane": {"origin": [0, 0, 0], "x": [1, 0, 0], "y": [0, 1, 0]},
      "outer": {"start": [0, 0], "segments": [{"line_to": [2, 0]}, {"line_to": [2, 2]}, {"line_to": [0, 2]}, {"line_to": [0, 0]}]}
    },
    {"name": "cube", "op": "extrude", "profile": "square", "direction": [0, 0, 1], "length": 2},
    {"name": "first", "op": "fillet", "of": "cube", "edges": [[2, 0, 1]], "radius": "r"},
    {"name": "result", "op": "fillet", "of": "first", "edges": [[2, 2, 1]], "radius": "r"}
  ],
  "result": "result",
  "probes": [
    {"label": "inside", "point": [1, 1, 1], "expect": "in"},
    {"label": "first_corner_gone", "point": [1.95, 0.05, 1], "expect": "out"},
    {"label": "second_corner_gone", "point": [1.95, 1.95, 1], "expect": "out"},
    {"label": "on_first_blend", "point": ["2 - r + r / sqrt(2)", "r - r / sqrt(2)", 1], "expect": "on"},
    {"label": "on_second_blend", "point": ["2 - r + r / sqrt(2)", "2 - r + r / sqrt(2)", 1], "expect": "on"},
    {"label": "on_shared_face", "point": [2, 1, 1], "expect": "on"},
    {"label": "on_second_arc", "point": ["2 - r + r / sqrt(2)", "2 - r + r / sqrt(2)", 2], "expect": "on"},
    {"label": "far_vertex", "point": [0, 0, 0], "expect": "on"}
  ],
  "analytic": {
    "volume": "8 - 2 * (1 - pi / 4) * r^2 * 2",
    "area": "24 - 2 * (4 * r + 2 * (1 - pi / 4) * r^2 - pi * r)",
    "counts": {"vertices": 12, "edges": 18, "faces": 8, "loops": 8, "shells": 1},
    "genus": 0
  }
}
