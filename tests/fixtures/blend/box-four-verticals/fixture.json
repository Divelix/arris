{
  "description": "the consumer's 2-cube with its four vertical edges filleted in one call at r 0.2: four disjoint plane–plane blends, each cap face taking four arcs and each of its edges cut at both ends by two different blends",
  "params": {"r": 0.2},
  "steps": [
    {"name": "cube", "op": "box", "min": [0, 0, 0], "max": [2, 2, 2]},
    {"name": "result", "op": "fillet", "of": "cube", "edges": [[0, 0, 1], [2, 0, 1], [2, 2, 1], [0, 2, 1]], "radius": "r"}
  ],
  "result": "result",
  "probes": [
    {"label": "inside", "point": [1, 1, 1], "expect": "in"},
    {"label": "corner_gone_00", "point": [0.05, 0.05, 1], "expect": "out"},
    {"label": "corner_gone_20", "point": [1.95, 0.05, 1], "expect": "out"},
    {"label": "corner_gone_22", "point": [1.95, 1.95, 1], "expect": "out"},
    {"label": "corner_gone_02", "point": [0.05, 1.95, 1], "expect": "out"},
    {"label": "on_blend", "point": ["r - r / sqrt(2)", "2 - r + r / sqrt(2)", 1], "expect": "on"},
    {"label": "on_contact", "point": ["2 - r", 0, 1], "expect": "on"},
    {"label": "on_arc", "point": ["r - r / sqrt(2)", "r - r / sqrt(2)", 2], "expect": "on"},
    {"label": "on_top_edge", "point": [1, 0, 2], "expect": "on"},
    {"label": "on_bottom", "point": [1, 1, 0], "expect": "on"}
  ],
  "analytic": {
    "volume": "8 - 4 * (1 - pi / 4) * r^2 * 2",
    "area": "24 - 16 * r - 8 * (1 - pi / 4) * r^2 + 4 * pi * r",
    "counts": {"vertices": 16, "edges": 24, "faces": 10, "loops": 10, "shells": 1},
    "genus": 0
  }
}
