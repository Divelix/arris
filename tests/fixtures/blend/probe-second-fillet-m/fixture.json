{
  "description": "the consumer's second-blend probe in its own units: a 0.1 m square extruded 0.1 in metres, the side edge at (s, 0) filleted at r 0.01, then the side edge at (s, s) of that result, at a micrometre default tolerance. The two edges never meet; their blends share the side face x = s, which the first blend modified and the second modifies again",
  "params": {"s": 0.1, "r": 0.01},
  "precision": {"default_tolerance": 1e-6},
  "steps": [
    {
      "name": "square",
      "op": "profile",
      "plane": {"origin": [0, 0, 0], "x": [1, 0, 0], "y": [0, 1, 0]},
      "outer": {"start": [0, 0], "segments": [{"line_to": ["s", 0]}, {"line_to": ["s", "s"]}, {"line_to": [0, "s"]}, {"line_to": [0, 0]}]}
    },
    {"name": "cube", "op": "extrude", "profile": "square", "direction": [0, 0, 1], "length": "s"},
    {"name": "first", "op": "fillet", "of": "cube", "edges": [["s", 0, "s / 2"]], "radius": "r"},
    {"name": "result", "op": "fillet", "of": "first", "edges": [["s", "s", "s / 2"]], "radius": "r"}
  ],
  "result": "result",
  "probes": [
    {"label": "inside", "point": ["s / 2", "s / 2", "s / 2"], "expect": "in"},
    {"label": "first_corner_gone", "point": [0.0975, 0.0025, 0.05], "expect": "out"},
    {"label": "second_corner_gone", "point": [0.0975, 0.0975, 0.05], "expect": "out"},
    {"label": "on_first_blend", "point": ["s - r + r / sqrt(2)", "r - r / sqrt(2)", "s / 2"], "expect": "on"},
    {"label": "on_second_blend", "point": ["s - r + r / sqrt(2)", "s - r + r / sqrt(2)", "s / 2"], "expect": "on"},
    {"label": "on_shared_face", "point": ["s", "s / 2", "s / 2"], "expect": "on"},
    {"label": "on_second_arc", "point": ["s - r + r / sqrt(2)", "s - r + r / sqrt(2)", "s"], "expect": "on"},
    {"label": "far_vertex", "point": [0, 0, 0], "expect": "on"}
  ],
  "tolerances": {"mesh_chord": 1e-5},
  "analytic": {
    "volume": "s^3 - 2 * (1 - pi / 4) * r^2 * s",
    "area": "6 * s^2 - 2 * (2 * r * s + 2 * (1 - pi / 4) * r^2 - pi * r * s / 2)",
    "counts": {"vertices": 12, "edges": 18, "faces": 8, "loops": 8, "shells": 1},
    "genus": 0
  }
}
