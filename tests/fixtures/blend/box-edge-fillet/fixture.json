{
  "description": "the consumer's 2-cube with one vertical edge filleted at r 0.2: a plane–plane blend, a cylinder of a quarter turn between two circle ends, its contacts at r from the edge; the `larger` variant at r 0.5",
  "params": {"r": 0.2},
  "variants": {"larger": {"r": 0.5}},
  "steps": [
    {"name": "cube", "op": "box", "min": [0, 0, 0], "max": [2, 2, 2]},
    {"name": "result", "op": "fillet", "of": "cube", "edges": [[2, 2, 1]], "radius": "r"}
  ],
  "result": "result",
  "probes": [
    {"label": "inside", "point": [1, 1, 1], "expect": "in"},
    {"label": "corner_gone", "point": [1.95, 1.95, 1], "expect": "out"},
    {"label": "on_blend", "point": ["2 - r + r / sqrt(2)", "2 - r + r / sqrt(2)", 1], "expect": "on"},
    {"label": "on_contact", "point": ["2 - r", 2, 1], "expect": "on"},
    {"label": "on_arc", "point": ["2 - r + r / sqrt(2)", "2 - r + r / sqrt(2)", 2], "expect": "on"},
    {"label": "on_top", "point": [1, 1, 2], "expect": "on"},
    {"label": "far_vertex", "point": [0, 0, 0], "expect": "on"}
  ],
  "analytic": {
    "volume": "8 - (1 - pi / 4) * r^2 * 2",
    "area": "24 - 4 * r - 2 * (1 - pi / 4) * r^2 + pi * r",
    "counts": {"vertices": 10, "edges": 15, "faces": 7, "loops": 7, "shells": 1},
    "genus": 0
  }
}
